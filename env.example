# TednCo Parkir — example environment only
# Copy to .env.local. Never commit real credentials or production secrets.
# Canonical minimal template: .env.example. Email names remain provisional.

# App (non-secret)
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Jakarta

# MongoDB Atlas — required when database integration is implemented
# Use a dedicated development database; transactions require replica-set support.
MONGODB_URI=
MONGODB_DB_NAME=tednco_parkir_dev

# Authentication — Better Auth
# Generate a long random secret locally; do not reuse between environments.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Password reset email — configure only after provider is chosen
# MAIL_FROM=no-reply@example.com
# MAIL_PROVIDER_API_KEY=

# Optional server-only observability (choose provider before enabling)
# ERROR_MONITORING_DSN=

# No NEXT_PUBLIC_ secrets. Do not place credentials in browser-exposed vars.
# Never use production MongoDB URI for automated tests.
